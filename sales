
CREATE TABLE sales (
    order_id INT,
    product_name VARCHAR(100),
    category VARCHAR(50),
    quantity INT,
    price DECIMAL(10, 2)
);

INSERT INTO sales VALUES
(1, 'Laptop', 'Electronics', 2, 800.00),
(2, 'Phone', 'Electronics', 5, 500.00),
(3, 'Chair', 'Furniture', 4, 120.00),
(4, 'Desk', 'Furniture', 2, 250.00),
(5, 'Tablet', 'Electronics', 3, 300.00);

-- Calculate total revenue
SELECT SUM(quantity * price) AS total_revenue
FROM sales;

-- Revenue by category
SELECT
    category,
    SUM(quantity * price) AS revenue
FROM sales
GROUP BY category
ORDER BY revenue DESC;

-- Find the highest-revenue product
SELECT
    product_name,
    SUM(quantity * price) AS revenue
FROM sales
GROUP BY product_name
ORDER BY revenue DESC
LIMIT 1;
